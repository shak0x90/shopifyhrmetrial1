{%- comment -%}
  Main Page — Static page content
{%- endcomment -%}

<section class="section main-page" id="page-{{ page.id }}">
  <div class="container container--narrow">
    <h1 class="h1 text-center" style="margin-bottom: var(--space-2xl);">{{ page.title }}</h1>
    <div class="rte">
      {{ page.content }}
    </div>
  </div>
</section>

<style>
  .rte {
    line-height: 1.8;
    color: var(--color-text-secondary);
  }
  .rte h2, .rte h3, .rte h4 { color: var(--color-text-primary); margin-top: var(--space-xl); margin-bottom: var(--space-md); }
  .rte p { margin-bottom: var(--space-md); }
  .rte ul, .rte ol { margin-bottom: var(--space-md); padding-left: var(--space-xl); }
  .rte img { max-width: 100%; height: auto; margin: var(--space-xl) 0; }
  .rte blockquote { border-left: 2px solid var(--color-border); padding-left: var(--space-lg); margin: var(--space-xl) 0; font-style: italic; }
</style>

{% schema %}
{
  "name": "Page content",
  "settings": []
}
{% endschema %}
