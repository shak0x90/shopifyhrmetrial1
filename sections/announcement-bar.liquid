{%- comment -%}
  Announcement Bar
  Features: dismissable, countdown timer, scrolling text
{%- endcomment -%}

{%- if section.settings.show_announcement -%}
<div
  class="announcement-bar"
  id="announcement-bar"
  x-data="{ dismissed: false }"
  x-show="!dismissed"
  x-transition:leave="transition ease-in duration-200"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  style="
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  "
  role="region"
  aria-label="{{ 'sections.announcement.label' | t }}"
>
  <div class="announcement-bar__inner container">
    <div class="announcement-bar__content">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="announcement-bar__link">
      {%- endif -%}

      <p class="announcement-bar__text label-sm">
        {{ section.settings.text }}
      </p>

      {%- if section.settings.show_countdown and section.settings.countdown_date != blank -%}
        <div
          class="announcement-bar__countdown label-sm"
          x-data="countdown('{{ section.settings.countdown_date }}')"
          x-init="start()"
        >
          <span x-text="days">00</span>D :
          <span x-text="hours">00</span>H :
          <span x-text="minutes">00</span>M :
          <span x-text="seconds">00</span>S
        </div>
      {%- endif -%}

      {%- if section.settings.link != blank -%}
        </a>
      {%- endif -%}
    </div>

    <button
      class="announcement-bar__close"
      @click="dismissed = true; sessionStorage.setItem('announcement_dismissed', 'true')"
      aria-label="{{ 'accessibility.close' | t }}"
    >
      {%- render 'icon', icon: 'close', size: 14 -%}
    </button>
  </div>
</div>
{%- endif -%}

<style>
  .announcement-bar {
    position: relative;
    z-index: var(--z-sticky);
    height: var(--announcement-height);
    display: flex;
    align-items: center;
  }

  .announcement-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    position: relative;
  }

  .announcement-bar__content {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .announcement-bar__text {
    margin: 0;
  }

  .announcement-bar__link {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .announcement-bar__countdown {
    display: flex;
    gap: var(--space-xs);
    font-variant-numeric: tabular-nums;
  }

  .announcement-bar__close {
    position: absolute;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    opacity: 0.7;
    transition: opacity var(--duration-fast);
  }

  .announcement-bar__close:hover {
    opacity: 1;
  }

  @media (max-width: 749px) {
    .announcement-bar__countdown {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Announcement bar",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Free Shipping Over $150 — Shop New Arrivals"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown",
      "default": false
    },
    {
      "type": "text",
      "id": "countdown_date",
      "label": "Countdown end date",
      "info": "Format: YYYY-MM-DD HH:MM"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1A1A1A"
    }
  ]
}
{% endschema %}
