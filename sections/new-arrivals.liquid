{%- comment -%}
  New Arrivals — Product grid (desktop) / horizontal scroll (mobile)
{%- endcomment -%}

<section class="section new-arrivals" id="new-arrivals-{{ section.id }}">
  <div class="container">
    <div class="section-header flex items-center justify-between" style="margin-bottom: var(--space-2xl);">
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.collection != blank -%}
        <a href="{{ collections[section.settings.collection].url }}" class="btn--text hide-mobile">
          {{ 'general.view_all' | t }}
        </a>
      {%- endif -%}
    </div>

    {%- assign collection = collections[section.settings.collection] -%}
    {%- assign product_count = section.settings.product_count -%}

    {%- comment -%} Desktop grid {%- endcomment -%}
    <div class="new-arrivals__grid grid grid--{{ section.settings.columns }} hide-mobile">
      {%- for product in collection.products limit: product_count -%}
        {%- render 'product-card', product: product, lazy: true -%}
      {%- else -%}
        {%- for i in (1..product_count) -%}
          <article class="product-card">
            <div class="product-card__media">
              <div class="skeleton aspect-3-4"></div>
            </div>
            <div class="product-card__info">
              <div class="skeleton" style="height: 14px; width: 60%;"></div>
              <div class="skeleton" style="height: 14px; width: 40%; margin-top: 8px;"></div>
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Mobile horizontal scroll {%- endcomment -%}
    <div class="new-arrivals__scroll scroll-x hide-desktop">
      {%- for product in collection.products limit: product_count -%}
        <div style="width: 70vw; max-width: 280px;">
          {%- render 'product-card', product: product, lazy: true -%}
        </div>
      {%- else -%}
        {%- for i in (1..4) -%}
          <div style="width: 70vw; max-width: 280px;">
            <div class="skeleton aspect-3-4"></div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.collection != blank -%}
      <div class="text-center hide-desktop" style="margin-top: var(--space-xl);">
        <a href="{{ collections[section.settings.collection].url }}" class="btn btn--secondary">
          {{ 'general.view_all' | t }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "New arrivals",
  "class": "new-arrivals-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Just In"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 2,
      "default": 8
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (desktop)",
      "default": "4",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ]
    }
  ],
  "presets": [
    {
      "name": "New arrivals",
      "category": "Products"
    }
  ]
}
{% endschema %}
