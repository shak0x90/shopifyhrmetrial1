{%- comment -%}
  Main Cart — Fallback cart page (non-drawer)
{%- endcomment -%}

<section class="section main-cart" id="main-cart">
  <div class="container container--narrow">
    <h1 class="h1 text-center" style="margin-bottom: var(--space-2xl);">{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart-form">
        <div class="cart-table">
          {%- for item in cart.items -%}
            <div class="cart-item" data-line="{{ forloop.index }}">
              <a href="{{ item.url }}" class="cart-item__img-link">
                {%- if item.image -%}
                  <img class="cart-item__img" src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="133" loading="lazy">
                {%- endif -%}
              </a>
              <div class="cart-item__info">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                <p class="text-meta">{{ item.variant.title }}</p>
                <div class="cart-item__bottom">
                  <div class="cart-item__quantity">
                    <label class="visually-hidden" for="qty-{{ forloop.index }}">Quantity</label>
                    <input class="input" type="number" id="qty-{{ forloop.index }}" name="updates[]" value="{{ item.quantity }}" min="0" style="width: 60px;">
                  </div>
                  <span class="cart-item__price price">{{ item.final_line_price | money }}</span>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="cart-footer text-right" style="margin-top: var(--space-2xl); padding-top: var(--space-xl); border-top: 1px solid var(--color-border);">
          <p class="h3" style="margin-bottom: var(--space-lg);">{{ 'cart.checkout' | t }}: {{ cart.total_price | money }}</p>
          <button type="submit" name="checkout" class="btn btn--primary btn--lg">{{ 'cart.checkout' | t }}</button>
        </div>
      </form>
    {%- else -%}
      <div class="text-center" style="padding: var(--space-3xl) 0;">
        <p class="h3" style="margin-bottom: var(--space-md);">{{ 'cart.empty_title' | t }}</p>
        <p class="text-meta" style="margin-bottom: var(--space-xl);">{{ 'cart.empty_description' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'cart.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart page",
  "settings": []
}
{% endschema %}
