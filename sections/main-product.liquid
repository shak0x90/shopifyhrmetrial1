{%- comment -%}
  Main Product Section — Conversion-critical product detail page
  Features: sticky image gallery, variant selection, accordions, cross-sell
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_image = current_variant.featured_image | default: product.featured_image
-%}

<section class="section main-product" id="product-{{ product.id }}">
  <div class="container">

    {%- comment -%} Breadcrumbs {%- endcomment -%}
    <nav class="breadcrumb body-sm" aria-label="Breadcrumb" style="margin-bottom: var(--space-xl);">
      <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
      <span aria-hidden="true">/</span>
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span aria-hidden="true">/</span>
      {%- endif -%}
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="split split--60-40">
      {%- comment -%} ===== LEFT: Image Gallery ===== {%- endcomment -%}
      <div class="product-gallery sticky" id="product-gallery">
        {%- comment -%} Main image {%- endcomment -%}
        <div class="product-gallery__main" x-data="{ activeImage: 0 }">
          {%- for image in product.images -%}
            <div
              class="product-gallery__slide"
              x-show="activeImage === {{ forloop.index0 }}"
              x-transition:enter="transition ease-out duration-300"
              x-transition:enter-start="opacity-0"
              x-transition:enter-end="opacity-100"
            >
              <img
                src="{{ image | image_url: width: 1200 }}"
                srcset="{{ image | image_url: width: 600 }} 600w,
                        {{ image | image_url: width: 900 }} 900w,
                        {{ image | image_url: width: 1200 }} 1200w"
                sizes="(min-width: 1024px) 55vw, 100vw"
                alt="{{ image.alt | default: product.title | escape }}"
                width="{{ image.width }}"
                height="{{ image.height }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                {% if forloop.first %}fetchpriority="high"{% endif %}
              >
            </div>
          {%- endfor -%}

          {%- comment -%} Thumbnails {%- endcomment -%}
          {%- if product.images.size > 1 -%}
            <div class="product-gallery__thumbs">
              {%- for image in product.images -%}
                <button
                  class="product-gallery__thumb"
                  :class="{ 'product-gallery__thumb--active': activeImage === {{ forloop.index0 }} }"
                  @click="activeImage = {{ forloop.index0 }}"
                  aria-label="View image {{ forloop.index }}"
                >
                  <img
                    src="{{ image | image_url: width: 120 }}"
                    alt="{{ image.alt | default: product.title | escape }}"
                    width="60"
                    height="80"
                    loading="lazy"
                  >
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ===== RIGHT: Product Info ===== {%- endcomment -%}
      <div class="product-info">
        {%- comment -%} Rating {%- endcomment -%}
        <div class="product-info__rating flex items-center gap-sm" style="margin-bottom: var(--space-sm);">
          <div class="flex gap-xs">
            {%- for i in (1..5) -%}
              {%- if i <= 4 -%}
                {%- render 'icon', icon: 'star', size: 14 -%}
              {%- else -%}
                {%- render 'icon', icon: 'star-empty', size: 14 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
          <span class="text-meta">({{ product.metafields.reviews.rating_count | default: 0 }} {{ 'products.product.reviews' | t }})</span>
        </div>

        {%- comment -%} Title {%- endcomment -%}
        <h1 class="h2" style="margin-bottom: var(--space-sm);">{{ product.title }}</h1>

        {%- comment -%} Price {%- endcomment -%}
        <div style="margin-bottom: var(--space-xl);">
          {%- render 'price', variant: current_variant, show_badge: true -%}
        </div>

        {%- comment -%} Variant form {%- endcomment -%}
        {%- form 'product', product, id: 'product-form', data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

          {%- for option in product.options_with_values -%}
            <div class="product-option" style="margin-bottom: var(--space-lg);">
              <label class="form-label">{{ option.name }}: <strong>{{ option.selected_value }}</strong></label>

              {%- if option.name == 'Color' or option.name == 'Colour' -%}
                {%- comment -%} Color swatches {%- endcomment -%}
                <div class="flex gap-sm" style="margin-top: var(--space-sm);">
                  {%- for value in option.values -%}
                    {%- assign color_handle = value | handleize -%}
                    <label class="swatch-label">
                      <input
                        type="radio"
                        name="option-{{ option.name | handleize }}"
                        value="{{ value }}"
                        class="visually-hidden"
                        {% if value == option.selected_value %}checked{% endif %}
                        data-option-selector
                      >
                      <span
                        class="swatch{% if value == option.selected_value %} swatch--active{% endif %}"
                        style="background-color: {{ color_handle }}; width: 32px; height: 32px;"
                        title="{{ value }}"
                      ></span>
                    </label>
                  {%- endfor -%}
                </div>

              {%- elsif option.name == 'Size' -%}
                {%- comment -%} Size buttons {%- endcomment -%}
                <div class="flex gap-sm" style="margin-top: var(--space-sm); flex-wrap: wrap;">
                  {%- for value in option.values -%}
                    {%- assign variant_available = true -%}
                    {%- for variant in product.variants -%}
                      {%- if variant.options contains value -%}
                        {%- unless variant.available -%}
                          {%- assign variant_available = false -%}
                        {%- endunless -%}
                      {%- endif -%}
                    {%- endfor -%}
                    <label>
                      <input
                        type="radio"
                        name="option-{{ option.name | handleize }}"
                        value="{{ value }}"
                        class="visually-hidden"
                        {% if value == option.selected_value %}checked{% endif %}
                        {% unless variant_available %}disabled{% endunless %}
                        data-option-selector
                      >
                      <span class="size-btn{% if value == option.selected_value %} size-btn--active{% endif %}{% unless variant_available %} size-btn--soldout{% endunless %}">
                        {{ value }}
                      </span>
                    </label>
                  {%- endfor -%}
                </div>

              {%- else -%}
                {%- comment -%} Default: dropdown {%- endcomment -%}
                <select name="option-{{ option.name | handleize }}" class="input" data-option-selector>
                  {%- for value in option.values -%}
                    <option value="{{ value }}" {% if value == option.selected_value %}selected{% endif %}>
                      {{ value }}
                    </option>
                  {%- endfor -%}
                </select>
              {%- endif -%}
            </div>
          {%- endfor -%}

          {%- comment -%} Urgency {%- endcomment -%}
          {%- if current_variant.inventory_quantity <= 5 and current_variant.inventory_quantity > 0 and current_variant.inventory_management == 'shopify' -%}
            <p class="product-urgency body-sm" style="color: var(--color-sale); margin-bottom: var(--space-lg);">
              ⚠ {{ 'products.product.low_stock' | t: count: current_variant.inventory_quantity }}
            </p>
          {%- endif -%}

          {%- comment -%} Add to Cart {%- endcomment -%}
          <button
            type="submit"
            class="btn btn--primary btn--full btn--lg"
            {% unless current_variant.available %}disabled{% endunless %}
            data-add-to-cart
          >
            {%- if current_variant.available -%}
              {{ 'products.product.add_to_cart' | t }} — {{ current_variant.price | money }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </button>
        {%- endform -%}

        {%- comment -%} Accordions {%- endcomment -%}
        <div class="product-accordions" style="margin-top: var(--space-2xl);">
          <div class="accordion">
            {%- for block in section.blocks -%}
              {%- if block.type == 'accordion' -%}
                <details class="accordion__item" {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
                  <summary class="accordion__trigger">
                    {{ block.settings.heading }}
                    {%- render 'icon', icon: 'plus', size: 16 -%}
                  </summary>
                  <div class="accordion__content">
                    {{ block.settings.content }}
                  </div>
                </details>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        {%- comment -%} Trust signals {%- endcomment -%}
        <div class="product-trust flex gap-xl justify-center" style="margin-top: var(--space-xl); padding-top: var(--space-xl); border-top: 1px solid var(--color-border);">
          <span class="flex items-center gap-xs text-meta">
            {%- render 'icon', icon: 'truck', size: 16 -%} {{ 'products.product.free_shipping' | t }}
          </span>
          <span class="flex items-center gap-xs text-meta">
            {%- render 'icon', icon: 'return', size: 16 -%} {{ 'products.product.free_returns' | t }}
          </span>
          <span class="flex items-center gap-xs text-meta">
            {%- render 'icon', icon: 'lock', size: 16 -%} {{ 'products.product.secure' | t }}
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

{%- comment -%} Product Recommendations {%- endcomment -%}
<section class="section product-recommendations" id="product-recs">
  <div class="container">
    <h2 class="h2 text-center" style="margin-bottom: var(--space-2xl);">{{ 'products.product.you_may_like' | t }}</h2>
    <div class="grid grid--4" data-product-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4">
      {%- for product in recommendations.products limit: 4 -%}
        {%- render 'product-card', product: product -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-text-secondary);
  }

  .breadcrumb a:hover {
    color: var(--color-text-primary);
  }

  .product-gallery__main {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .product-gallery__main img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .product-gallery__thumbs {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    overflow-x: auto;
  }

  .product-gallery__thumb {
    flex-shrink: 0;
    border: 1px solid transparent;
    border-radius: var(--radius);
    overflow: hidden;
    opacity: 0.6;
    transition: all var(--duration-fast);
  }

  .product-gallery__thumb--active,
  .product-gallery__thumb:hover {
    opacity: 1;
    border-color: var(--color-text-primary);
  }

  .product-gallery__thumb img {
    width: 60px;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  @media (max-width: 749px) {
    .product-gallery {
      position: relative !important;
      top: auto !important;
    }

    .product-trust {
      flex-direction: column;
      align-items: center;
    }
  }
</style>

{% schema %}
{
  "name": "Product page",
  "class": "main-product-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "sticky_gallery",
      "label": "Sticky gallery on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Description"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product page",
      "blocks": [
        { "type": "accordion", "settings": { "heading": "Description" } },
        { "type": "accordion", "settings": { "heading": "Size & Fit" } },
        { "type": "accordion", "settings": { "heading": "Material & Care" } },
        { "type": "accordion", "settings": { "heading": "Shipping & Returns" } }
      ]
    }
  ]
}
{% endschema %}
