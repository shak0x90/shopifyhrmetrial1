{%- comment -%}
  Footer — Multi-column layout with nav, newsletter, social, payment icons
{%- endcomment -%}

<footer class="footer section" id="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer__grid">
      {%- comment -%} Logo & brand text {%- endcomment -%}
      <div class="footer__brand">
        <a href="{{ routes.root_url }}" class="footer__logo" aria-label="{{ shop.name }}">
          {%- if settings.logo != blank -%}
            <img
              src="{{ settings.logo | image_url: width: 200 }}"
              alt="{{ shop.name }}"
              width="120"
              loading="lazy"
            >
          {%- else -%}
            <span class="h3" style="letter-spacing: 0.15em;">{{ settings.logo_text | default: shop.name }}</span>
          {%- endif -%}
        </a>
        {%- if section.settings.brand_text != blank -%}
          <p class="body-sm" style="margin-top: var(--space-md); max-width: 280px;">
            {{ section.settings.brand_text }}
          </p>
        {%- endif -%}

        {%- comment -%} Social icons {%- endcomment -%}
        <div class="footer__social flex gap-md" style="margin-top: var(--space-lg);">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 0010.86 4.46V13a8.23 8.23 0 005.58 2.17V11.7a4.85 4.85 0 01-2.83-.94V6.69h2.83z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_pinterest != blank -%}
            <a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0a12 12 0 00-4.37 23.17c-.1-.93-.18-2.36.04-3.38l1.56-6.6s-.4-.8-.4-1.97c0-1.85 1.07-3.23 2.4-3.23 1.14 0 1.68.85 1.68 1.87 0 1.14-.72 2.85-1.1 4.43-.31 1.32.67 2.4 1.97 2.4 2.37 0 4.18-2.5 4.18-6.1 0-3.2-2.3-5.43-5.57-5.43a5.77 5.77 0 00-6.02 5.78c0 1.14.44 2.37.99 3.03.1.13.12.24.09.37l-.37 1.52c-.06.24-.2.29-.44.18C4.86 14.88 3.6 12.5 3.6 10.12c0-4.12 3-7.9 8.62-7.9 4.53 0 8.04 3.22 8.04 7.54 0 4.5-2.83 8.11-6.76 8.11-1.32 0-2.56-.69-2.98-1.5l-.81 3.1c-.29 1.14-1.08 2.56-1.61 3.43A12 12 0 1012 0z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Navigation columns {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            <h4 class="footer__heading label-sm">{{ block.settings.heading }}</h4>
            <ul class="footer__links">
              {%- for link in linklists[block.settings.menu].links -%}
                <li>
                  <a href="{{ link.url }}" class="footer__link">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Bottom bar {%- endcomment -%}
    <div class="footer__bottom">
      <div class="footer__copyright body-sm">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.footer.rights' | t }}.
      </div>
      <div class="footer__payment">
        {%- unless shop.enabled_payment_types == empty -%}
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- endfor -%}
        {%- endunless -%}
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }

  .footer__heading {
    margin-bottom: var(--space-lg);
    color: var(--color-text-secondary);
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer__link {
    font-size: calc(14px * var(--font-body-scale));
    color: var(--color-text-primary);
    transition: opacity var(--duration-fast);
  }

  .footer__link:hover {
    opacity: 0.6;
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .footer__payment {
    display: flex;
    gap: var(--space-sm);
  }

  .payment-icon {
    width: 38px;
    height: 24px;
  }

  @media (max-width: 749px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }

    .footer__bottom {
      flex-direction: column;
      gap: var(--space-md);
      text-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand description",
      "default": "Curated collections for the modern wardrobe. Timeless design, responsibly made."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "menu",
        "settings": { "heading": "Shop", "menu": "footer" }
      },
      {
        "type": "menu",
        "settings": { "heading": "Help", "menu": "footer" }
      },
      {
        "type": "menu",
        "settings": { "heading": "About", "menu": "footer" }
      }
    ]
  }
}
{% endschema %}
