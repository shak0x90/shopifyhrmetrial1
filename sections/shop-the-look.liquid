{%- comment -%}
  Shop the Look — Full-width editorial image with clickable product hotspots
  Priority: HIGH (per UX spec)
{%- endcomment -%}

<section
  class="section section--flush shop-the-look"
  id="shop-the-look-{{ section.id }}"
  x-data="{ activeHotspot: null }"
  @click.outside="activeHotspot = null"
>
  <div class="container" style="margin-bottom: var(--space-2xl);">
    {%- if section.settings.subheading != blank -%}
      <span class="label text-center" style="color: var(--color-text-secondary); display: block; margin-bottom: var(--space-md);">
        {{ section.settings.subheading }}
      </span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="h2 text-center">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  <div class="shop-the-look__canvas">
    {%- comment -%} Background editorial image {%- endcomment -%}
    <div class="shop-the-look__media">
      {%- if section.settings.image != blank -%}
        <img
          class="shop-the-look__img"
          src="{{ section.settings.image | image_url: width: 1920 }}"
          srcset="{{ section.settings.image | image_url: width: 1080 }} 1080w,
                  {{ section.settings.image | image_url: width: 1440 }} 1440w,
                  {{ section.settings.image | image_url: width: 1920 }} 1920w"
          sizes="100vw"
          alt="{{ section.settings.heading | default: 'Shop the Look' | escape }}"
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      {%- else -%}
        <div class="shop-the-look__placeholder">
          <div class="shop-the-look__placeholder-inner">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <path d="m21 15-5-5L5 21"/>
            </svg>
            <p class="label-sm" style="opacity: 0.5; margin-top: var(--space-md);">Add an editorial image in theme settings</p>
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Hotspot dots {%- endcomment -%}
    {%- for block in section.blocks -%}
      <div
        class="hotspot"
        style="left: {{ block.settings.position_x }}%; top: {{ block.settings.position_y }}%;"
        {{ block.shopify_attributes }}
      >
        <button
          class="hotspot__dot"
          @click.stop="activeHotspot = activeHotspot === {{ forloop.index0 }} ? null : {{ forloop.index0 }}"
          :class="{ 'hotspot__dot--active': activeHotspot === {{ forloop.index0 }} }"
          aria-label="View product: {{ block.settings.product.title | default: 'Product' | escape }}"
          aria-expanded="activeHotspot === {{ forloop.index0 }}"
        >
          <span class="hotspot__pulse"></span>
          <span class="hotspot__plus">+</span>
        </button>

        {%- comment -%} Mini product card popup {%- endcomment -%}
        {%- assign hotspot_product = block.settings.product -%}
        <div
          class="hotspot__card"
          x-show="activeHotspot === {{ forloop.index0 }}"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 scale-95"
          x-transition:enter-end="opacity-100 scale-100"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-100 scale-100"
          x-transition:leave-end="opacity-0 scale-95"
          x-cloak
          @click.stop
        >
          {%- if hotspot_product != blank -%}
            <a href="{{ hotspot_product.url }}" class="hotspot__card-link">
              <div class="hotspot__card-image">
                <img
                  src="{{ hotspot_product.featured_image | image_url: width: 200 }}"
                  alt="{{ hotspot_product.title | escape }}"
                  width="80"
                  height="100"
                  loading="lazy"
                >
              </div>
              <div class="hotspot__card-info">
                <p class="hotspot__card-title">{{ hotspot_product.title }}</p>
                <p class="hotspot__card-price price">{{ hotspot_product.price | money }}</p>
              </div>
            </a>
          {%- else -%}
            <div class="hotspot__card-link">
              <div class="hotspot__card-image">
                <div class="skeleton" style="width: 80px; height: 100px;"></div>
              </div>
              <div class="hotspot__card-info">
                <p class="hotspot__card-title">{{ block.settings.label | default: 'Product' }}</p>
                <p class="hotspot__card-price price">Select product</p>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<style>
  .shop-the-look__canvas {
    position: relative;
    overflow: hidden;
  }

  .shop-the-look__media {
    width: 100%;
  }

  .shop-the-look__img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .shop-the-look__placeholder {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .shop-the-look__placeholder-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
  }

  /* Hotspot dot */
  .hotspot {
    position: absolute;
    z-index: 10;
    transform: translate(-50%, -50%);
  }

  .hotspot__dot {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 2px solid var(--color-text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--duration-base) var(--ease-out);
    box-shadow: var(--shadow-md);
  }

  .hotspot__dot:hover,
  .hotspot__dot--active {
    background: var(--color-text-primary);
    transform: scale(1.1);
  }

  .hotspot__plus {
    font-size: 18px;
    font-weight: 300;
    line-height: 1;
    color: var(--color-text-primary);
    transition: color var(--duration-fast);
  }

  .hotspot__dot:hover .hotspot__plus,
  .hotspot__dot--active .hotspot__plus {
    color: var(--color-background);
  }

  /* Pulse animation */
  .hotspot__pulse {
    position: absolute;
    inset: -6px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-text-primary);
    opacity: 0;
    animation: hotspotPulse 2s ease-out infinite;
  }

  @keyframes hotspotPulse {
    0% { transform: scale(0.8); opacity: 0.6; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  /* Mini product card */
  .hotspot__card {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%);
    width: 220px;
    background: var(--color-surface);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    z-index: 20;
  }

  .hotspot__card-link {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-md);
    text-decoration: none;
    color: inherit;
    transition: background var(--duration-fast);
  }

  a.hotspot__card-link:hover {
    background: var(--color-background);
  }

  .hotspot__card-image img {
    width: 80px;
    height: 100px;
    object-fit: cover;
    border-radius: var(--radius);
    flex-shrink: 0;
  }

  .hotspot__card-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-xs);
    min-width: 0;
  }

  .hotspot__card-title {
    font-size: calc(13px * var(--font-body-scale));
    font-weight: 500;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hotspot__card-price {
    font-size: calc(13px * var(--font-body-scale)) !important;
  }

  /* Mobile: card opens below instead of above */
  @media (max-width: 749px) {
    .hotspot__dot {
      width: 30px;
      height: 30px;
    }

    .hotspot__card {
      bottom: auto;
      top: calc(100% + 8px);
      width: 180px;
    }

    .shop-the-look__img {
      aspect-ratio: 4 / 5;
    }
  }
</style>

{% schema %}
{
  "name": "Shop the Look",
  "class": "shop-the-look-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated Style"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the Look"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial image",
      "info": "Recommended: 1920×1080px landscape"
    }
  ],
  "blocks": [
    {
      "type": "product_pin",
      "name": "Product hotspot",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label (fallback)",
          "default": "Product"
        },
        {
          "type": "range",
          "id": "position_x",
          "label": "Horizontal position",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 50,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "position_y",
          "label": "Vertical position",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 50,
          "unit": "%"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the Look",
      "category": "Image",
      "blocks": [
        {
          "type": "product_pin",
          "settings": {
            "position_x": 30,
            "position_y": 40
          }
        },
        {
          "type": "product_pin",
          "settings": {
            "position_x": 60,
            "position_y": 55
          }
        },
        {
          "type": "product_pin",
          "settings": {
            "position_x": 75,
            "position_y": 30
          }
        }
      ]
    }
  ]
}
{% endschema %}
