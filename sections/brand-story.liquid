{%- comment -%}
  Brand Story — Centered editorial text block with optional image
{%- endcomment -%}

<section class="section brand-story" id="brand-story-{{ section.id }}">
  <div class="container container--narrow">
    <div class="brand-story__layout{% if section.settings.image != blank %} brand-story__layout--with-image brand-story__layout--{{ section.settings.layout }}{% endif %}">

      {%- if section.settings.image != blank -%}
        <div class="brand-story__media">
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            srcset="{{ section.settings.image | image_url: width: 400 }} 400w,
                    {{ section.settings.image | image_url: width: 600 }} 600w,
                    {{ section.settings.image | image_url: width: 800 }} 800w"
            sizes="(min-width: 1024px) 400px, 100vw"
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        </div>
      {%- endif -%}

      <div class="brand-story__text text-center">
        {%- if section.settings.subheading != blank -%}
          <span class="label" style="color: var(--color-text-secondary); margin-bottom: var(--space-md); display: block;">
            {{ section.settings.subheading }}
          </span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="h2" style="margin-bottom: var(--space-lg);">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="brand-story__body body-lg" style="color: var(--color-text-secondary); line-height: 1.8;">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_text != blank -%}
          <div style="margin-top: var(--space-xl);">
            <a href="{{ section.settings.button_link }}" class="btn--text">{{ section.settings.button_text }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .brand-story__layout--with-image {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  .brand-story__layout--image-left {
    grid-template-columns: 1fr 1fr;
  }

  .brand-story__layout--image-right {
    grid-template-columns: 1fr 1fr;
  }

  .brand-story__layout--image-right .brand-story__media {
    order: 2;
  }

  .brand-story__media img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .brand-story__layout--with-image .brand-story__text {
    text-align: left;
  }

  @media (max-width: 749px) {
    .brand-story__layout--with-image {
      grid-template-columns: 1fr;
    }

    .brand-story__layout--with-image .brand-story__text {
      text-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "Brand story",
  "class": "brand-story-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Timeless Design, Responsibly Made"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text",
      "default": "<p>We believe in creating pieces that transcend seasons. Each garment is thoughtfully designed with quality fabrics and meticulous attention to detail, because true style never goes out of fashion.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "default": "image-left",
      "options": [
        { "value": "image-left", "label": "Image left" },
        { "value": "image-right", "label": "Image right" }
      ]
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Brand story",
      "category": "Text"
    }
  ]
}
{% endschema %}
