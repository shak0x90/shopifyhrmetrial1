{%- comment -%} Customer Register {%- endcomment -%}

<section class="section main-register" id="main-register">
  <div class="container container--narrow text-center" style="max-width: 480px;">
    <h1 class="h1" style="margin-bottom: var(--space-2xl);">Create Account</h1>

    {%- form 'create_customer' -%}
      {%- if form.errors -%}
        <p class="form-error" style="color: var(--color-sale); margin-bottom: var(--space-md);">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div style="display: flex; flex-direction: column; gap: var(--space-md); text-align: left;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md);">
          <div>
            <label class="form-label" for="first-name">First name</label>
            <input class="input" type="text" id="first-name" name="customer[first_name]" autocomplete="given-name" required>
          </div>
          <div>
            <label class="form-label" for="last-name">Last name</label>
            <input class="input" type="text" id="last-name" name="customer[last_name]" autocomplete="family-name" required>
          </div>
        </div>
        <div>
          <label class="form-label" for="reg-email">Email</label>
          <input class="input" type="email" id="reg-email" name="customer[email]" autocomplete="email" required>
        </div>
        <div>
          <label class="form-label" for="reg-password">Password</label>
          <input class="input" type="password" id="reg-password" name="customer[password]" autocomplete="new-password" required>
        </div>
        <button type="submit" class="btn btn--primary btn--full">Create Account</button>
      </div>

      <p class="body-sm" style="margin-top: var(--space-lg); color: var(--color-text-secondary);">
        Already have an account? <a href="{{ routes.account_login_url }}">Sign in</a>
      </p>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Customer register", "settings": [] }
{% endschema %}
