{%- comment -%} 404 Page {%- endcomment -%}

<section class="section main-404" id="main-404">
  <div class="container container--narrow text-center" style="padding: var(--space-4xl) 0;">
    <h1 class="h1" style="font-size: calc(120px * var(--font-heading-scale)); margin-bottom: var(--space-lg);">404</h1>
    <p class="h3" style="margin-bottom: var(--space-md);">Page not found</p>
    <p class="body-lg" style="color: var(--color-text-secondary); margin-bottom: var(--space-xl);">The page you're looking for doesn't exist or has been moved.</p>
    <a href="{{ routes.root_url }}" class="btn btn--primary">Back to Home</a>
  </div>
</section>

{% schema %}
{ "name": "404 page", "settings": [] }
{% endschema %}
