{%- comment -%}
  Newsletter — Email capture section
{%- endcomment -%}

<section class="section newsletter" id="newsletter-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="container container--narrow text-center">
    {%- if section.settings.heading != blank -%}
      <h2 class="h2" style="margin-bottom: var(--space-md);">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="body-lg" style="color: var(--color-text-secondary); margin-bottom: var(--space-xl); max-width: 480px; margin-left: auto; margin-right: auto;">
        {{ section.settings.description }}
      </p>
    {%- endif -%}

    {%- form 'customer', id: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">

      {%- if form.errors -%}
        <p class="form-error" role="alert">{{ form.errors.messages['email'] }}</p>
      {%- endif -%}

      {%- if form.posted_successfully? -%}
        <p class="form-success body-lg" role="status">{{ section.settings.success_message }}</p>
      {%- else -%}
        <div class="newsletter__form flex gap-sm justify-center">
          <input
            class="input newsletter__input"
            type="email"
            name="contact[email]"
            placeholder="{{ 'general.newsletter.email_placeholder' | t }}"
            required
            autocomplete="email"
            aria-label="{{ 'general.newsletter.email_placeholder' | t }}"
          >
          <button type="submit" class="btn btn--primary">
            {{ section.settings.button_text | default: 'Subscribe' }}
          </button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

<style>
  .newsletter__form {
    max-width: 480px;
    margin: 0 auto;
  }

  .newsletter__input {
    flex: 1;
    min-width: 0;
  }

  .form-success {
    color: var(--color-success);
  }

  .form-error {
    color: var(--color-sale);
    margin-bottom: var(--space-md);
  }

  @media (max-width: 749px) {
    .newsletter__form {
      flex-direction: column;
    }
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "class": "newsletter-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the List"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Be the first to know about new arrivals, exclusive events, and insider-only promotions."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for subscribing."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FAF8F5"
    }
  ],
  "presets": [
    {
      "name": "Newsletter",
      "category": "Contact"
    }
  ]
}
{% endschema %}
