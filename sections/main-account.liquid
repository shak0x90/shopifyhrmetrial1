{%- comment -%} Customer Account {%- endcomment -%}

<section class="section main-account" id="main-account">
  <div class="container">
    <div class="flex items-center justify-between" style="margin-bottom: var(--space-2xl);">
      <h1 class="h1">My Account</h1>
      <a href="{{ routes.account_logout_url }}" class="btn--text">Sign Out</a>
    </div>
    <div class="grid grid--2" style="gap: var(--space-2xl);">
      <div>
        <h2 class="h3" style="margin-bottom: var(--space-lg);">Order History</h2>
        {%- if customer.orders.size > 0 -%}
          {%- for order in customer.orders -%}
            <div style="padding: var(--space-md) 0; border-bottom: 1px solid var(--color-border);">
              <a href="{{ order.customer_url }}" class="body-sm" style="font-weight: 500;">{{ order.name }}</a>
              <span class="text-meta"> — {{ order.created_at | date: '%B %d, %Y' }} — {{ order.total_price | money }}</span>
            </div>
          {%- endfor -%}
        {%- else -%}
          <p class="text-meta">No orders yet.</p>
        {%- endif -%}
      </div>
      <div>
        <h2 class="h3" style="margin-bottom: var(--space-lg);">Details</h2>
        <p><strong>{{ customer.name }}</strong></p>
        <p class="body-sm" style="color: var(--color-text-secondary);">{{ customer.email }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Customer account", "settings": [] }
{% endschema %}
