{%- comment -%} Password / Coming Soon Page {%- endcomment -%}

<section class="section main-password" id="main-password">
  <div class="container container--narrow text-center" style="padding: var(--space-4xl) 0;">
    <h1 class="h1" style="margin-bottom: var(--space-md);">{{ shop.name }}</h1>
    <p class="body-lg" style="color: var(--color-text-secondary); margin-bottom: var(--space-2xl);">{{ shop.password_message }}</p>

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="form-error" style="color: var(--color-sale); margin-bottom: var(--space-md);">{{ form.errors.messages['form'] }}</p>
      {%- endif -%}
      <div class="flex gap-sm justify-center" style="max-width: 400px; margin: 0 auto;">
        <input class="input" type="password" name="password" placeholder="Enter password" style="flex: 1;">
        <button type="submit" class="btn btn--primary">Enter</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Password page", "settings": [] }
{% endschema %}
