<!DOCTYPE html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ request.locale.text_layout_direction }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="{{ settings.color_background }}">

  <title>
    {%- if template.name == 'index' -%}
      {{ shop.name }} — {{ shop.description | default: 'Premium Fashion' }}
    {%- else -%}
      {{ page_title }} — {{ shop.name }}
    {%- endif -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {%- render 'meta-tags' -%}

  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  {%- comment -%} Preconnect to external resources {%- endcomment -%}
  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

  {%- comment -%} Font preloading {%- endcomment -%}
  {% style %}
    {{ settings.font_heading | font_face: font_display: 'swap' }}
    {{ settings.font_body | font_face: font_display: 'swap' }}
  {% endstyle %}

  {%- comment -%} Theme stylesheet {%- endcomment -%}
  {{ 'theme.css' | asset_url | stylesheet_tag: preload: true }}

  {%- comment -%} Shopify required {%- endcomment -%}
  {{ content_for_header }}

  {%- comment -%} Theme JS — must load BEFORE Alpine so Alpine.data() registrations are ready {%- endcomment -%}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>

  {%- comment -%} Alpine.js — lightweight reactivity for drawers, accordions, menus {%- endcomment -%}
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

  {%- comment -%} Theme JS state {%- endcomment -%}
  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    window.Atelier = {
      routes: {
        cart_url: '{{ routes.cart_url }}',
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        search_url: '{{ routes.search_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      },
      money_format: {{ shop.money_format | json }},
      free_shipping_threshold: {{ settings.free_shipping_threshold | default: '150' | times: 100 }},
      free_shipping_enabled: {{ settings.free_shipping_enabled | default: true }}
    };
  </script>
</head>

<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}--{{ template.suffix }}{% endif %}">

  <a class="skip-link visually-hidden" href="#main-content">
    {{ 'accessibility.skip_to_content' | t }}
  </a>

  {%- comment -%} ===== ANNOUNCEMENT BAR ===== {%- endcomment -%}
  {%- section 'announcement-bar' -%}

  {%- comment -%} ===== HEADER ===== {%- endcomment -%}
  {%- section 'header' -%}

  {%- comment -%} ===== CART DRAWER ===== {%- endcomment -%}
  {%- section 'cart-drawer' -%}

  {%- comment -%} ===== MAIN CONTENT ===== {%- endcomment -%}
  <main id="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- comment -%} ===== FOOTER ===== {%- endcomment -%}
  {%- section 'footer' -%}

  {%- comment -%} ===== MOBILE BOTTOM NAV ===== {%- endcomment -%}
  {%- section 'mobile-bottom-nav' -%}

  {%- comment -%} ===== QUICK VIEW MODAL ===== {%- endcomment -%}
  <div class="quick-view" id="quick-view-modal" role="dialog" aria-modal="true" aria-label="Quick view">
    <div class="quick-view__overlay"></div>
    <div class="quick-view__container">
      <button class="quick-view__close" data-quick-view-close aria-label="Close quick view">
        {%- render 'icon', icon: 'close', size: 20 -%}
      </button>
      <div class="quick-view__body"></div>
    </div>
  </div>

  {%- comment -%} Product JSON for recently viewed tracking {%- endcomment -%}
  {%- if template.name == 'product' -%}
    <script type="application/json" data-product-json>
      {
        "title": {{ product.title | json }},
        "featured_image": {{ product.featured_image | image_url: width: 360 | json }},
        "price_formatted": {{ product.price | money | json }}
      }
    </script>
  {%- endif -%}

</body>
</html>
